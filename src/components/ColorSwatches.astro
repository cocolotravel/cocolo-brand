---
import { colors, groupLabel } from "./tokens.js";

// Group colors by their group name (e.g. "background", "brand"). Colors
// arrive pre-sorted semantic-first, primitives last.
const groups = {};
for (const c of colors) (groups[c.group] ??= []).push(c);
---

{Object.entries(groups).map(([group, items]) => (
  <section class="swatch-group">
    <h3>{groupLabel(group)}</h3>
    <div class="swatches">
      {items.map((c) => (
        <figure class="swatch">
          <button
            class="chip"
            style={`background: var(${c.cssVar})`}
            data-copy={c.value}
            title="Copy hex"
          ></button>
          <figcaption>
            <strong>{c.label}</strong>
            <button class="code" data-copy={c.value}>{c.value}</button>
            <button class="code" data-copy={`var(${c.cssVar})`}>var</button>
          </figcaption>
        </figure>
      ))}
    </div>
  </section>
))}

<style>
  .swatch-group { margin: 1.5rem 0 2.5rem; }
  .swatches { display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: 1rem; }
  .swatch { margin: 0; border: 1px solid var(--sl-color-gray-5); border-radius: 10px; overflow: hidden; }
  .chip { display: block; width: 100%; height: 84px; border: 0; cursor: pointer; padding: 0; }
  figcaption { padding: 0.6rem 0.7rem; display: flex; flex-wrap: wrap; align-items: center; gap: 0.4rem; }
  figcaption strong { width: 100%; text-transform: capitalize; font-family: var(--font-style-roslindale, serif); }
  .code { font: inherit; font-size: 0.75rem; background: var(--sl-color-gray-6); border: 1px solid var(--sl-color-gray-5); color: var(--sl-color-text); border-radius: 5px; padding: 0.15rem 0.4rem; cursor: pointer; }
  .code:hover { border-color: var(--color-brand-sumi, #1b3848); }
</style>

<script>
  // Copy-to-clipboard for every chip and code button
  document.querySelectorAll("[data-copy]").forEach((el) => {
    el.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(el.getAttribute("data-copy"));
        const prev = el.textContent;
        if (el.classList.contains("code")) { el.textContent = "copied"; setTimeout(() => (el.textContent = prev), 800); }
      } catch {}
    });
  });
</script>
